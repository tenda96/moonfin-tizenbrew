{
  "name": "moonfin-tizenbrew",
  "version": "2.6.0",
  "type": "module",
  "description": "Moonfin Smart TV packaged as a TizenBrew application module",
  "packageType": "app",
  "appName": "Moonfin",
  "appPath": "app/index.html",
  "evaluateScriptOnDocumentStart": false,
  "keys": [
    "Back",
    "Return",
    "Exit",
    "MediaPlay",
    "MediaPause",
    "MediaPlayPause",
    "MediaStop",
    "MediaFastForward",
    "MediaRewind",
    "MediaTrackPrevious",
    "MediaTrackNext",
    "ColorF0Red",
    "ColorF1Green",
    "ColorF2Yellow",
    "ColorF3Blue",
    "Info",
    "Search",
    "ChannelUp",
    "ChannelDown"
  ],
  "files": [
    "app",
    "scripts",
    "tizen-adapter.js",
    "README.md"
  ],
  "scripts": {
    "patch:bundle": "node scripts/patch-moonfin-bundle.mjs",
    "verify": "node scripts/verify-tizenbrew-module.mjs"
  }
}
